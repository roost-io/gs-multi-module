package com.example.multimodule.service;import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;
import org.springframework.boot.context.properties.EnableConfigurationProperties;
import org.springframework.stereotype.Service;

@ExtendWith(MockitoExtension.class)
class MyServiceMessageTest {
    
    @Mock
    private ServiceProperties serviceProperties;
    
    private MyService myService;
    
    @BeforeEach
    void setUp() {
        myService = new MyService(serviceProperties);
    }
    
    @Test
    @Tag("valid")
    void messageReturnsServicePropertiesMessage() {
        // Arrange
        String expectedMessage = "Hello World";
        when(serviceProperties.getMessage()).thenReturn(expectedMessage);
        // Act
        String actualMessage = myService.message();
        // Assert
        assertEquals(expectedMessage, actualMessage);
        verify(serviceProperties, times(1)).getMessage();
    }
    
    @Test
    @Tag("boundary")
    void messageReturnsNullWhenServicePropertiesReturnsNull() {
        // Arrange
        when(serviceProperties.getMessage()).thenReturn(null);
        // Act
        String actualMessage = myService.message();
        // Assert
        assertNull(actualMessage);
        verify(serviceProperties, times(1)).getMessage();
    }
    
    @Test
    @Tag("boundary")
    void messageReturnsEmptyStringWhenConfigured() {
        // Arrange
        String emptyMessage = "";
        when(serviceProperties.getMessage()).thenReturn(emptyMessage);
        // Act
        String actualMessage = myService.message();
        // Assert
        assertNotNull(actualMessage);
        assertEquals("", actualMessage);
        assertEquals(0, actualMessage.length());
        verify(serviceProperties, times(1)).getMessage();
    }
    
    @Test
    @Tag("valid")
    void messageReturnsSpecialCharactersCorrectly() {
        // Arrange
        String specialCharMessage = "Hello\nWorld\t@#$%€\r\n\"quotes\"\\backslash";
        when(serviceProperties.getMessage()).thenReturn(specialCharMessage);
        // Act
        String actualMessage = myService.message();
        // Assert
        assertEquals(specialCharMessage, actualMessage);
        assertTrue(actualMessage.contains("\n"));
        assertTrue(actualMessage.contains("\t"));
        assertTrue(actualMessage.contains("€"));
        verify(serviceProperties, times(1)).getMessage();
    }
    
    @Test
    @Tag("boundary")
    void messageReturnsLongStringWithoutTruncation() {
        // Arrange
        StringBuilder longMessageBuilder = new StringBuilder();
        for (int i = 0; i < 10000; i++) {
            longMessageBuilder.append("a");
        }
        String longMessage = longMessageBuilder.toString();
        when(serviceProperties.getMessage()).thenReturn(longMessage);
        // Act
        String actualMessage = myService.message();
        // Assert
        assertNotNull(actualMessage);
        assertEquals(10000, actualMessage.length());
        assertEquals(longMessage, actualMessage);
        verify(serviceProperties, times(1)).getMessage();
    }
    
    @Test
    @Tag("valid")
    void messageReturnsConsistentValueOnMultipleCalls() {
        // Arrange
        String consistentMessage = "Consistent Message";
        when(serviceProperties.getMessage()).thenReturn(consistentMessage);
        // Act
        String firstCall = myService.message();
        String secondCall = myService.message();
        String thirdCall = myService.message();
        // Assert
        assertEquals(consistentMessage, firstCall);
        assertEquals(consistentMessage, secondCall);
        assertEquals(consistentMessage, thirdCall);
        assertEquals(firstCall, secondCall);
        assertEquals(secondCall, thirdCall);
        verify(serviceProperties, times(3)).getMessage();
    }
    
    @Test
    @Tag("valid")
    void messageReturnsUnicodeCharactersCorrectly() {
        // Arrange
        String unicodeMessage = "Hello 世界 🌍 مرحبا мир";
        when(serviceProperties.getMessage()).thenReturn(unicodeMessage);
        // Act
        String actualMessage = myService.message();
        // Assert
        assertEquals(unicodeMessage, actualMessage);
        assertTrue(actualMessage.contains("世界"));
        assertTrue(actualMessage.contains("🌍"));
        verify(serviceProperties, times(1)).getMessage();
    }
    
    @Test
    @Tag("boundary")
    void messageReturnsWhitespaceOnlyString() {
        // Arrange
        String whitespaceMessage = "   \t\n\r   ";
        when(serviceProperties.getMessage()).thenReturn(whitespaceMessage);
        // Act
        String actualMessage = myService.message();
        // Assert
        assertNotNull(actualMessage);
        assertEquals(whitespaceMessage, actualMessage);
        assertEquals(11, actualMessage.length());
        verify(serviceProperties, times(1)).getMessage();
    }
    
    @Test
    @Tag("valid")
    void messageReturnsNumericString() {
        // Arrange
        String numericMessage = "1234567890";
        when(serviceProperties.getMessage()).thenReturn(numericMessage);
        // Act
        String actualMessage = myService.message();
        // Assert
        assertEquals(numericMessage, actualMessage);
        assertEquals("1234567890", actualMessage);
        verify(serviceProperties, times(1)).getMessage();
    }
    
    @Test
    @Tag("valid")
    void messageReturnsSingleCharacterString() {
        // Arrange
        String singleCharMessage = "A";
        when(serviceProperties.getMessage()).thenReturn(singleCharMessage);
        // Act
        String actualMessage = myService.message();
        // Assert
        assertEquals(singleCharMessage, actualMessage);
        assertEquals(1, actualMessage.length());
        verify(serviceProperties, times(1)).getMessage();
    }
}