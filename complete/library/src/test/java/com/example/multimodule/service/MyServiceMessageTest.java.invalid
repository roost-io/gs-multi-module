package com.example.multimodule.service;import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertNull;
import org.springframework.boot.context.properties.EnableConfigurationProperties;
import org.springframework.stereotype.Service;

@EnableConfigurationProperties
@Service
public class MyServiceMessageTest {
    private ServiceProperties serviceProperties;
    private MyService myService;
    @BeforeEach
    public void setUp() {
        serviceProperties = Mockito.mock(ServiceProperties.class);
        myService = new MyService(serviceProperties);
    }
    @Test
    @Tag("valid")
    public void testReturnsStandardMessage() {
        Mockito.when(serviceProperties.getMessage()).thenReturn("Hello, World!");
        String result = myService.message();
        assertEquals((String) "Hello, World!", (String) result);
    }
    @Test
    @Tag("invalid")
    public void testReturnsNullWhenServicePropertiesReturnsNull() {
        Mockito.when(serviceProperties.getMessage()).thenReturn(null);
        String result = myService.message();
        assertNull((String) result);
    }
    @Test
    @Tag("boundary")
    public void testReturnsEmptyStringWhenServicePropertiesReturnsEmpty() {
        Mockito.when(serviceProperties.getMessage()).thenReturn("");
        String result = myService.message();
        assertEquals((String) "", (String) result);
    }
    @Test
    @Tag("boundary")
    public void testReturnsSpecialCharacterMessage() {
        String specialMessage = "¡Hola! 你好 😊";
        Mockito.when(serviceProperties.getMessage()).thenReturn(specialMessage);
        String result = myService.message();
        assertEquals((String) specialMessage, (String) result);
    }
    @Test
    @Tag("boundary")
    public void testReturnsLongMessage() {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < 10000; i++) {
            sb.append('a');
        }
        String longMessage = sb.toString();
        Mockito.when(serviceProperties.getMessage()).thenReturn(longMessage);
        String result = myService.message();
        assertEquals((String) longMessage, (String) result);
    }
    @Test
    @Tag("boundary")
    public void testReturnsMessageWithWhitespace() {
        String paddedMessage = "   padded message   ";
        Mockito.when(serviceProperties.getMessage()).thenReturn(paddedMessage);
        String result = myService.message();
        assertEquals((String) paddedMessage, (String) result);
    }
    @Test
    @Tag("integration")
    public void testUsesInjectedServiceProperties() {
        String uniqueMessage = "Unique message from mock";
        Mockito.when(serviceProperties.getMessage()).thenReturn(uniqueMessage);
        MyService injectedService = new MyService(serviceProperties);
        String result = injectedService.message();
        assertEquals((String) uniqueMessage, (String) result);
    }
    @Test
    @Tag("boundary")
    public void testReturnsMessageWithNewlinesAndTabs() {
        String formattedMessage = "Line1\nLine2\tTabbed";
        Mockito.when(serviceProperties.getMessage()).thenReturn(formattedMessage);
        String result = myService.message();
        assertEquals((String) formattedMessage, (String) result);
    }
    @Test
    @Tag("boundary")
    public void testReturnsWhitespaceOnlyMessage() {
        String whitespaceMessage = "     ";
        Mockito.when(serviceProperties.getMessage()).thenReturn(whitespaceMessage);
        String result = myService.message();
        assertEquals((String) whitespaceMessage, (String) result);
    }
    @Test
    @Tag("boundary")
    public void testReturnsMessageWithEscapeSequences() {
        String escapeMessage = "Path: C:\\Users\\Name\\\"File.txt\"";
        Mockito.when(serviceProperties.getMessage()).thenReturn(escapeMessage);
        String result = myService.message();
        assertEquals((String) escapeMessage, (String) result);
    }
}